generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  previewFeatures = ["interactiveTransactions"]
  seed = "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MODERATOR
  EMPLOYER
  JOB_SEEKER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCE
}

enum JobStatus {
  OPEN
  CLOSED
  PAUSED
}

model User {
  id          String            @id @default(cuid())
  name        String
  phone       String            @unique
  email       String            @unique
  language    String            @default("en")
  role        UserRole
  createdAt   DateTime          @default(now())

  // Relations
  jobListings JobListing[]      @relation("EmployerJobs")
  profile     JobSeekerProfile? @relation("SeekerProfile")
  applications JobApplication[] @relation("UserApplications")
}

model JobListing {
  id          String     @id @default(cuid())
  title       String
  description String
  company     String
  location    String
  tags        String[]
  salary      String?
  jobType     JobType    @default(FULL_TIME)
  status      JobStatus  @default(OPEN)
  createdAt   DateTime   @default(now())

  // Relations
  employerId  String
  employer    User       @relation("EmployerJobs", fields: [employerId], references: [id])
  applications JobApplication[] @relation("JobApplications")

  @@index([location, createdAt])
}

model JobSeekerProfile {
  id           String   @id @default(cuid())
  bio          String?
  experience   String?
  education    String?
  resumeUrl    String?
  jobSeekerId  String   @unique
  jobSeeker    User     @relation("SeekerProfile", fields: [jobSeekerId], references: [id])

  // Skill relation
  skills       SkillOnProfile[]
}

model Skill {
  id    String  @id @default(cuid())
  name  String  @unique

  // Many-to-many with profiles
  profiles SkillOnProfile[]
}

model SkillOnProfile {
  id        String             @id @default(cuid())
  skill     Skill              @relation(fields: [skillId], references: [id])
  skillId   String
  profile   JobSeekerProfile   @relation(fields: [profileId], references: [id])
  profileId String

  @@unique([skillId, profileId])
}

model JobApplication {
  id         String     @id @default(cuid())
  userId     String
  jobId      String
  appliedAt  DateTime   @default(now())
  status     String     @default("pending") // Can be updated to enum later (e.g., PENDING, ACCEPTED, REJECTED)

  user       User       @relation("UserApplications", fields: [userId], references: [id])
  job        JobListing @relation("JobApplications", fields: [jobId], references: [id])

  @@unique([userId, jobId]) // Prevent duplicate applications
}
